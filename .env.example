# Copy to .env and fill the passwords, or run ./scripts/setup.sh which
# generates random ones and stores them in Secrets Manager on Floci.
# .env is in .gitignore. Never commit real values.

# Images (pinned versions)
PLATFORM_IMAGE=ghcr.io/virtocommerce/platform:3.1076.13
PLATFORM_LOCAL_IMAGE=virto-platform:3.1076.13-b16.0.13
FRONTEND_VERSION=2.59.1
FRONTEND_LOCAL_IMAGE=virto-frontend:2.59.1

# Host ports (bound to 127.0.0.1 only)
FRONTEND_PORT=8088
PLATFORM_PORT=8090
PLATFORM_PUBLIC_URL=http://localhost:8090

# Database
POSTGRES_DB=virto
POSTGRES_USER=virto
POSTGRES_PASSWORD=change-me

# Cache (Valkey, Redis compatible)
CACHE_PASSWORD=change-me

# Platform admin. The image starts with admin / store.
# setup-platform.sh changes it to this value on first run.
VC_ADMIN_USER=admin
VC_ADMIN_PASSWORD=change-me

# Floci (local AWS emulator)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
