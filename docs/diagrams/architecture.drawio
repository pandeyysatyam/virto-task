hed=1;dashPattern=6 4;" edge="1" parent="1" source="local-35" target="local-36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="local-43" value="&lt;b&gt;scripts/&lt;/b&gt; (bash, run on the host)&lt;br&gt;setup.sh: Floci + Terraform + .env from Secrets Manager&lt;br&gt;deploy.sh: build, up, wait healthy, init platform, record release in SSM&lt;br&gt;validate.sh / test-persistence.sh / failure-drill.sh&lt;br&gt;backup.sh / restore.sh: pg_dump + volumes to S3&lt;br&gt;monitor.sh: health metric + logs to CloudWatch&lt;br&gt;rollback.sh: previous image tags from release history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#000000;fontStyle=0;fontSize=12;arcSize=6;dashed=0;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="240" y="860" width="600" height="150" as="geometry"/></mxCell><mxCell id="local-44" value=".env  (mode 600, git-ignored)&lt;br&gt;passwords from Secrets Manager" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;fillColor=#FFF9E6;strokeColor=#B3A26B;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="900" y="900" width="220" height="60" as="geometry"/></mxCell><mxCell id="local-45" value="setup.sh reads secrets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="local-31" target="local-44"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1140" y="210"/><mxPoint x="1140" y="930"/></Array></mxGeometry></mxCell><mxCell id="local-46" value="docker compose reads .env" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6