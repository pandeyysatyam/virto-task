th="900" height="20" as="geometry"/></mxCell><mxCell id="aws-3" value="ECS Fargate: frontend 2-4 tasks, platform 2-4 tasks, CPU target 60%, circuit breaker rollback. Frontend reaches platform via Cloud Map (platform.virto-prod.local:8080).&lt;br&gt;Security groups chain: alb -&gt; frontend -&gt; platform -&gt; db / cache / efs / search. Tasks reach ECR, CloudWatch and Secrets Manager through the NAT gateway." style="text;html=1;fontSize=11;align=left;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1500" height="34" as="geometry"/></mxCell><mxCell id="aws-4" value="Shoppers" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="60" height="60" as="geometry"/></mxCell><mxCell id="aws-5" value="Admins&lt;br&gt;(office / VPN IPs)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="60" height="60" as="geometry"/></mxCell><mxCell id="aws-6" value="GitHub Actions&lt;br&gt;(OIDC, no keys)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="60" height="60" as="geometry"/></mxCell><mxCell id="aws-7" value="AWS Cloud" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;font