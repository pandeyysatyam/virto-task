# Copy to terraform.tfvars (ignored by git) and fill in.
account_id          = "123456789012"
region              = "ap-south-1"
environment         = "prod"
shop_domain         = "shop.example.com"
admin_domain        = "admin.example.com"
route53_zone_id     = "Z0000000000000000000"
admin_allowed_cidrs = ["203.0.113.0/24"] # office / VPN egress
alert_emails        = ["ops@example.com"]
github_repository   = "your-org/virto-commerce-devops"
platform_image      = "123456789012.dkr.ecr.ap-south-1.amazonaws.com/virto-prod/platform:3.1076.13-b16.0.13"
frontend_image      = "123456789012.dkr.ecr.ap-south-1.amazonaws.com/virto-prod/frontend:2.59.1"
